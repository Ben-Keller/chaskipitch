# Copy this file to creative-pitch/pipeline/.env and fill in values.

# Required for OpenAI keyframe generation in image_gen.
OPENAI_API_KEY=

# Optional model used to generate style-varied start prompt variants.
OPENAI_PROMPT_MODEL=gpt-4o-mini

# Required for Runway animation generation in animation_gen.
RUNWAYML_API_SECRET=

# Optional Runway API version header.
RUNWAY_API_VERSION=2024-11-06

# Optional timeout (seconds) for waiting on Runway async tasks.
RUNWAY_POLL_TIMEOUT_SECONDS=900
